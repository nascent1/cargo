# Optional. Tests work without this file.
#
# The test database name is set in phpunit.xml (uclp_cargo_test), and the host, user and
# password are read from .env. Create .env.testing only when the test database needs
# different credentials from the development database, for example on a build server.
#
# When .env.testing exists, Laravel reads it INSTEAD OF .env during tests. So start from a
# full copy of .env and change only the lines below:
#
#   cp .env .env.testing
#
# Keep APP_KEY the same as in .env. .env.testing is ignored by git; never commit it.

APP_ENV=testing

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
# Must end in _test: tests refuse to run on any other database (tests/TestCase.php).
DB_DATABASE=uclp_cargo_test
DB_USERNAME=
DB_PASSWORD=
